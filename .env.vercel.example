# Copy to .env.local for Next.js locally, or add in Vercel > Environment Variables.
# Never prefix these with NEXT_PUBLIC_. The secret key and the admin token stay on the server only.
# Leave the Supabase values empty to keep the local demonstration (data saved only in each browser).

# Servidor do jogo e chat ao vivo (Supabase > Project Settings > API Keys). Guia: CONFIGURAR_SUPABASE.md
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Minimum 32 random characters; used by scripts/game-admin.mjs (Authorization: Bearer).
MAP_ADMIN_TOKEN=

# Legacy houses routes (Projeto 1) on Cloudflare D1. Not used by the war game.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Instagram can remain off while choosing the account and campaign.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_MEDIA_IDS=
INSTAGRAM_PROFILE=
